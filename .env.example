# QYZYLORDA INDUSTRIAL INTELLIGENCE — environment template
# Copy to .env and adjust. All values are optional; defaults work locally.

# --- Server ---
HOST=127.0.0.1
PORT=8771

# --- Frontend (Vite) ---
# Base URL of the API as seen from the browser. Leave empty for same-origin.
VITE_API=/api

# --- Storage ---
# Local by default (JSON files under backend/data). For object storage set a
# backend key here and implement the storage adapter (see README roadmap).
STORAGE_BACKEND=local

# --- AI ---
# "rules" = built-in rule-based engine (default, no external calls).
# "external" = plug in an LLM provider later via the AI abstraction layer.
AI_PROVIDER=rules
# Do NOT put real API keys in the frontend. If you enable an external
# provider, configure it server-side only:
# EXTERNAL_AI_BASE_URL=
# EXTERNAL_AI_API_KEY=

# --- Security ---
# Session token TTL seconds (in-memory + JSON persisted)
SESSION_TTL=86400

# --- Data rules ---
# Tolerance (%) for treating a document value as matching the site DB
MATCH_TOLERANCE_PCT=1.0
MAX_UPLOAD_MB=25
